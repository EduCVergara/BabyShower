---
import '@fontsource/great-vibes/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '../styles/global.css';
import InvitationEffects from '../components/InvitationEffects.astro';
import { invitation as config, templates, responsiveMedia, type Placement } from '../config/invitation';

const template = templates[config.template];
const { latitude, longitude, provider } = config.location;
const hasLocation = latitude !== null && longitude !== null;
const coordinates = `${latitude},${longitude}`;
const mapUrl = hasLocation
  ? provider === 'waze'
    ? `https://www.waze.com/ul?ll=${encodeURIComponent(coordinates)}&navigate=yes`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(coordinates)}`
  : undefined;
const phone = config.whatsapp.phone.replace(/\D/g, '');
const rsvpUrl = phone ? `https://wa.me/${phone}?text=${encodeURIComponent(config.whatsapp.message)}` : undefined;
const variables = (box: Placement, prefix = '') => `--${prefix}x:${box.x}%;--${prefix}y:${box.y}%;--${prefix}width:${box.width}%;--${prefix}height:${box.height}%;--${prefix}size:${box.fontSize}cqw`;
const position = (box: Placement, mobile: Placement, tall: Placement) => [variables(box), variables(mobile, 'mobile-'), variables(tall, 'tall-')].join(';');
const entries = Object.entries(config.text) as [keyof typeof config.text, string][];
const scriptKeys = ['name', 'farewell'];
const bodyKeys = ['introduction', 'day', 'time', 'parents', 'address'];
// Clases compartidas para editar una sola vez todos los textos y botones.
const placedClasses = 'placed invitation-position absolute -translate-x-1/2 -translate-y-1/2 m-0 flex items-center justify-center text-center font-normal leading-[1.15]';
const fitClasses = 'block max-w-full whitespace-pre-wrap [overflow-wrap:anywhere]';
const actionClasses = `${placedClasses} action z-1 rounded-full pl-[6.5%] pr-[1.3%] text-white no-underline italic [text-shadow:0_1px_2px_#825e5e55] transition-colors duration-200 hover:bg-white/[0.14] focus-visible:outline-3 focus-visible:outline-(--accent) focus-visible:outline-offset-4 aria-disabled:cursor-default motion-reduce:transition-none before:absolute before:top-1/2 before:left-0 before:h-[max(100%,min(44px,6cqw))] before:w-full before:-translate-y-1/2 before:content-['']`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={template.background} />
    <meta name="description" content={config.description} />
    <meta property="og:title" content={config.title} />
    <meta property="og:description" content={config.description} />
    <title>{config.title}</title>
  </head>
  <body class="m-0 grid min-h-svh place-items-center bg-(--paper) font-body text-(--ink) [padding:env(safe-area-inset-top)_env(safe-area-inset-right)_env(safe-area-inset-bottom)_env(safe-area-inset-left)]" style={`--accent:${template.accent};--ink:${template.ink};--paper:${template.background}`}>
    <InvitationEffects enabled={config.animations} effects={config.effects} />
    <main class="invitation-frame m-auto">
      <div class="invitation relative [container-type:inline-size] shadow-[0_8px_70px_#9b665521]">
        <picture>
          <source media={responsiveMedia.tall} srcset={template.variants.tall.image} width={template.variants.tall.width} height={template.variants.tall.height} />
          <source media={responsiveMedia.mobile} srcset={template.variants.mobile.image} width={template.variants.mobile.width} height={template.variants.mobile.height} />
          <img class="block h-auto w-full" src={template.image} alt="" width={template.width} height={template.height} fetchpriority="high" />
        </picture>
        {entries.map(([key, value]) => {
          const Tag = key === 'name' ? 'h1' : 'p';
          return <Tag data-text={key} class:list={[placedClasses, bodyKeys.includes(key) ? 'text-(--ink)' : 'text-(--accent)', { 'font-script leading-[1.1]': scriptKeys.includes(key), 'tracking-[0.075em]': !scriptKeys.includes(key) && !bodyKeys.includes(key) }]} style={position(template.layout[key], template.variants.mobile.layout[key], template.variants.tall.layout[key])}>
            {key === 'name' ? <>
              <span class="sr-only">{value}</span>
              <svg data-name-arc={config.nameArc} class="block h-full w-full overflow-visible" aria-hidden="true">
                <defs><path id="name-curve" /></defs>
                <text class="fill-current"><textPath href="#name-curve" startOffset="50%" text-anchor="middle">{value}</textPath></text>
              </svg>
            </> : <span data-fit class:list={[fitClasses, { 'px-[0.12em] py-[0.05em]': scriptKeys.includes(key) }]}>{value}</span>}
          </Tag>;
        })}
        {config.animations && <div class="pointer-events-none absolute inset-0 overflow-hidden motion-reduce:hidden" aria-hidden="true">
          {[0, 1, 2, 3, 4, 5].map(i => <span class="absolute bottom-[4%] left-[calc(8%+var(--i)*16%)] animate-float text-[clamp(15px,3cqw,24px)] text-(--accent) opacity-0 [animation-delay:calc(var(--i)*-2s)]" style={`--i:${i}`}>♡</span>)}
        </div>}
        <a class={actionClasses} style={position(template.buttons.location, template.variants.mobile.buttons.location, template.variants.tall.buttons.location)} href={mapUrl}
          aria-disabled={!mapUrl ? 'true' : undefined} target="_blank" rel="noopener noreferrer"
          aria-label={mapUrl ? config.buttons.location.label : 'Ubicación pendiente de configurar'}>
          <span data-fit class={fitClasses}>{config.buttons.location.label}</span>
        </a>
        <a class={actionClasses} style={position(template.buttons.rsvp, template.variants.mobile.buttons.rsvp, template.variants.tall.buttons.rsvp)} href={rsvpUrl}
          aria-disabled={!rsvpUrl ? 'true' : undefined} target="_blank" rel="noopener noreferrer"
          aria-label={rsvpUrl ? 'Confirmar asistencia por WhatsApp' : 'Confirmación pendiente de configurar'}>
          <span data-fit class={fitClasses}>{config.buttons.rsvp.label}</span>
        </a>
      </div>
      {(!mapUrl || !rsvpUrl) && <p class="px-5 pb-4 text-center text-base leading-normal">Pronto podrás consultar la ubicación y confirmar tu asistencia aquí.</p>}
    </main>
  </body>
</html>

<script>
  // Ajusta textos largos al espacio asignado, también cuando cambian fuentes o ancho.
  function fitText() {
    document.querySelectorAll<SVGSVGElement>('[data-name-arc]').forEach(svg => {
      const box = svg.parentElement!;
      const width = box.clientWidth;
      const height = box.clientHeight;
      if (!width || !height) return;
      const curve = Math.max(0, Math.min(.08, Number(svg.dataset.nameArc) || 0));
      const baseline = height * .82;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.querySelector('path')!.setAttribute('d', `M ${width * .03} ${baseline} Q ${width / 2} ${baseline - width * curve * 2} ${width * .97} ${baseline}`);
      const text = svg.querySelector('text')!;
      let low = 1;
      let high = parseFloat(getComputedStyle(box).fontSize);
      for (let i = 0; i < 12; i++) {
        const size = (low + high) / 2;
        text.style.fontSize = `${size}px`;
        const bounds = text.getBBox();
        if (text.getComputedTextLength() > width * .92 || bounds.y < 0 || bounds.y + bounds.height > height) high = size;
        else low = size;
      }
      text.style.fontSize = `${low}px`;
    });
    document.querySelectorAll<HTMLElement>('[data-fit]').forEach(text => {
      const box = text.parentElement!;
      text.style.fontSize = '';
      const maximum = parseFloat(getComputedStyle(text).fontSize);
      const style = getComputedStyle(box);
      const width = box.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      let low = 1;
      let high = maximum;
      for (let i = 0; i < 12; i++) {
        const size = (low + high) / 2;
        text.style.fontSize = `${size}px`;
        if (text.scrollWidth > width + 1 || text.scrollHeight > box.clientHeight + 1) high = size;
        else low = size;
      }
      text.style.fontSize = `${low}px`;
    });
  }
  document.fonts.ready.then(fitText);
  const invitation = document.querySelector('.invitation');
  if (invitation) new ResizeObserver(fitText).observe(invitation);
</script>

<style is:inline set:html={`
  @media ${responsiveMedia.mobile} {
    main { --card-ratio: 0.5625; }
    .placed { --active-x:var(--mobile-x); --active-y:var(--mobile-y); --active-width:var(--mobile-width); --active-height:var(--mobile-height); --active-size:var(--mobile-size); }
  }
  @media ${responsiveMedia.tall} {
    main { --card-ratio: ${1080 / 2340}; }
    .placed { --active-x:var(--tall-x); --active-y:var(--tall-y); --active-width:var(--tall-width); --active-height:var(--tall-height); --active-size:var(--tall-size); }
  }
`} />
